{# Colaborador: retirada (step = checkout) ou devolução (step = checkin). Mobile-first. #}
{% macro problems_list(types, hint) %}
    <div data-ci-section="problems" hidden class="mt-3">
        <p class="fw-bold mb-2">{{ __('Marque os problemas encontrados:', 'checklistitens') }}</p>
        {% for t in types %}
            <div data-ci-type="{{ t.itemtype }}" hidden>
                {% for group in t.problems %}
                    <div class="ci-problem-group">
                        <div class="ci-problem-group-title">{{ group.label }}</div>
                        {% for p in group.problems %}
                            <label class="ci-problem">
                                <input type="checkbox" name="problems[]" value="{{ p.id }}" class="form-check-input">
                                <span>{{ p.name }}</span>
                            </label>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-warning">{{ __('Não há problemas cadastrados para este tipo. Avise o TI.', 'checklistitens') }}</div>
                {% endfor %}
            </div>
        {% endfor %}
        <div class="alert alert-warning mt-2 mb-0"><i class="ti ti-lock"></i> {{ hint }}</div>
    </div>
{% endmacro %}

{% macro ok_question(number) %}
    <h3 class="ci-step-title"><span class="ci-step-number">{{ number }}</span> {{ __('Equipamento ok?', 'checklistitens') }}</h3>
    <div class="row g-2">
        <div class="col-6">
            <label class="ci-choice ci-choice-ok">
                <input type="radio" name="is_ok" value="1" class="ci-choice-input">
                <span class="ci-choice-box"><i class="ti ti-circle-check"></i> {{ __('SIM', 'checklistitens') }}</span>
            </label>
        </div>
        <div class="col-6">
            <label class="ci-choice ci-choice-nok">
                <input type="radio" name="is_ok" value="0" class="ci-choice-input">
                <span class="ci-choice-box"><i class="ti ti-alert-triangle"></i> {{ __('NÃO', 'checklistitens') }}</span>
            </label>
        </div>
    </div>
{% endmacro %}

{% import _self as ci %}

<div class="ci-page container-fluid" data-ci-idle="{{ idle_seconds }}" data-ci-logout="{{ logout_url }}">
    <h2 class="ci-title mb-3">
        {% if step == 'checkout' %}
            <i class="ti ti-login"></i> {{ __('Iniciar uso de equipamento', 'checklistitens') }}
        {% else %}
            <i class="ti ti-logout"></i> {{ __('Finalizar uso de equipamento', 'checklistitens') }}
        {% endif %}
    </h2>

    {% if not has_sector %}
        <div class="alert alert-warning">
            {{ __('Você não está em nenhum grupo (setor) no GLPI, então nenhum equipamento aparece. Procure o TI.', 'checklistitens') }}
        </div>
    {% elseif step == 'checkout' %}
        <div class="text-muted small mb-2"><i class="ti ti-users"></i> {{ __('Seu setor', 'checklistitens') }}: {{ sector_names }}</div>
    {% endif %}

    {% if my_usages|length and step == 'checkout' %}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">{{ __('Equipamentos com você', 'checklistitens') }}</h3>
            </div>
            <div class="list-group list-group-flush">
                {% for u in my_usages %}
                    <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <i class="{{ u.icon }}"></i> <strong>{{ u.label }}</strong>
                            <span class="text-muted small">{{ u.detail }}</span>
                            <div class="small text-muted">{{ __('Retirado em', 'checklistitens') }} {{ u.checkout }}</div>
                        </div>
                        <span class="badge bg-{{ u.status_color }}">{{ u.status_label }}</span>
                    </div>
                {% endfor %}
            </div>
            <div class="card-footer">
                <a href="{{ checkin_url }}" class="btn btn-outline-primary w-100">
                    <i class="ti ti-logout"></i> {{ __('Devolver um equipamento', 'checklistitens') }}
                </a>
            </div>
        </div>
    {% endif %}

    {% if step == 'checkout' %}
        {# ---------------------------------------------------------------- RETIRADA #}
        <form method="post" action="{{ post_url }}" enctype="multipart/form-data" data-ci-flow="checkout">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="action" value="checkout">

            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="ci-step-title"><span class="ci-step-number">1</span> {{ __('Tipo de equipamento', 'checklistitens') }}</h3>
                    <div class="row g-2">
                        {% for t in types %}
                            <div class="col-6">
                                <label class="ci-choice">
                                    <input type="radio" name="itemtype" value="{{ t.itemtype }}" class="ci-choice-input" {{ t.itemtype == selected_type ? 'checked' }}>
                                    <span class="ci-choice-box"><i class="{{ t.icon }}"></i> {{ t.short_label }}</span>
                                </label>
                            </div>
                        {% else %}
                            <div class="col-12"><div class="alert alert-warning">{{ __('Nenhum tipo de equipamento habilitado. Avise o TI.', 'checklistitens') }}</div></div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="card mb-3" data-ci-section="item" hidden>
                <div class="card-body">
                    <h3 class="ci-step-title"><span class="ci-step-number">2</span> {{ __('Equipamento', 'checklistitens') }}</h3>
                    <input type="search" class="form-control form-control-lg mb-2" data-ci-filter
                           placeholder="{{ __('Buscar pelo número de série ou nome', 'checklistitens') }}">
                    {% for t in types %}
                        <div data-ci-type="{{ t.itemtype }}" hidden>
                            {% if t.limit_reached %}
                                <div class="alert alert-warning">
                                    {{ __('Você já está com o limite de %1$s deste tipo. Devolva antes de retirar outro.', 'checklistitens')|format(t.limit) }}
                                </div>
                            {% elseif t.items|length == 0 %}
                                <div class="alert alert-info">{{ __('Nenhum equipamento deste tipo disponível no seu setor agora.', 'checklistitens') }}</div>
                                {% if t.diagnostic %}
                                    {% set d = t.diagnostic %}
                                    <div class="alert alert-secondary small">
                                        <strong>{{ __('Diagnóstico (visível só para o TI)', 'checklistitens') }}</strong>
                                        <ul class="mb-0">
                                            {% if not d.type_supported %}<li>{{ __('Tipo indisponível (plugin Radios inativo?).', 'checklistitens') }}</li>{% endif %}
                                            {% if not d.type_enabled %}<li>{{ __('Tipo desabilitado na configuração do plugin.', 'checklistitens') }}</li>{% endif %}
                                            <li>{{ __('Setor considerado', 'checklistitens') }}: {{ d.sector ?: __('nenhum grupo', 'checklistitens') }}</li>
                                            <li>{{ __('Estados disponíveis na configuração', 'checklistitens') }}: {{ d.states ?: __('nenhum (configure em Configuração)', 'checklistitens') }}</li>
                                            <li>{{ __('Itens deste tipo no setor', 'checklistitens') }}: {{ d.in_sector }}</li>
                                            <li>{{ __('Desses, em estado disponível', 'checklistitens') }}: {{ d.available_state }}</li>
                                            <li>{{ __('Em uso agora', 'checklistitens') }}: {{ d.open }} · {{ __('bloqueados', 'checklistitens') }}: {{ d.blocked }}</li>
                                        </ul>
                                    </div>
                                {% endif %}
                            {% else %}
                                <div class="ci-item-list">
                                    {% for i in t.items %}
                                        <label class="ci-item" data-ci-search="{{ (i.label ~ ' ' ~ i.detail)|lower }}">
                                            <input type="radio" name="items_id" value="{{ i.id }}" class="form-check-input">
                                            <span>
                                                <strong>{{ i.label }}</strong>
                                                {% if i.detail %}<br><small class="text-muted">{{ i.detail }}</small>{% endif %}
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="card mb-3" data-ci-section="check" hidden>
                <div class="card-body">
                    {{ ci.ok_question(3) }}
                    {{ ci.problems_list(types, __('Este equipamento será bloqueado e conferido pelo gestor. Depois você escolhe outro.', 'checklistitens')) }}
                    <button type="submit" name="refuse" value="1" class="btn btn-warning btn-lg w-100 mt-3" data-ci-section="refuse" data-ci-require="problems" hidden>
                        <i class="ti ti-lock"></i> {{ __('Bloquear e escolher outro', 'checklistitens') }}
                    </button>
                </div>
            </div>

            <div class="card mb-3" data-ci-section="selfie" hidden>
                <div class="card-body">
                    <h3 class="ci-step-title"><span class="ci-step-number">4</span> {{ __('Selfie', 'checklistitens') }}</h3>
                    {% include '@checklistitens/parts/selfie_input.html.twig' %}
                    <button type="submit" name="save" value="1" class="btn btn-success btn-lg w-100 mt-3" data-ci-require="selfie">
                        <i class="ti ti-device-floppy"></i> {{ __('Salvar e sair', 'checklistitens') }}
                    </button>
                </div>
            </div>
        </form>
    {% else %}
        {# ---------------------------------------------------------------- DEVOLUÇÃO #}
        <form method="post" action="{{ post_url }}" enctype="multipart/form-data" data-ci-flow="checkin">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="action" value="checkin">

            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="ci-step-title"><span class="ci-step-number">1</span> {{ __('Qual equipamento você vai devolver?', 'checklistitens') }}</h3>
                    <div class="ci-item-list">
                        {% for u in my_usages %}
                            <label class="ci-item {{ u.can_return ? '' : 'ci-item-disabled' }}">
                                <input type="radio" name="usage_id" value="{{ u.id }}" class="form-check-input"
                                       data-ci-itemtype="{{ u.itemtype }}" {{ u.can_return ? '' : 'disabled' }}>
                                <span>
                                    <i class="{{ u.icon }}"></i> <strong>{{ u.label }}</strong>
                                    {% if u.detail %}<small class="text-muted">{{ u.detail }}</small>{% endif %}
                                    <br><small class="text-muted">{{ __('Retirado em', 'checklistitens') }} {{ u.checkout }}</small>
                                    {% if not u.can_return %}
                                        <br><span class="badge bg-{{ u.status_color }}">{{ __('Aguardando conferência do gestor', 'checklistitens') }}</span>
                                    {% endif %}
                                </span>
                            </label>
                        {% else %}
                            <div class="alert alert-info">{{ __('Você não está com nenhum equipamento.', 'checklistitens') }}</div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="card mb-3" data-ci-section="check" hidden>
                <div class="card-body">
                    {{ ci.ok_question(2) }}
                    {{ ci.problems_list(types, __('O equipamento será devolvido e ficará bloqueado até o TI resolver.', 'checklistitens')) }}
                </div>
            </div>

            <div class="card mb-3" data-ci-section="selfie" hidden>
                <div class="card-body">
                    <h3 class="ci-step-title"><span class="ci-step-number">3</span> {{ __('Selfie', 'checklistitens') }}</h3>
                    {% include '@checklistitens/parts/selfie_input.html.twig' %}
                    <button type="submit" name="save" value="1" class="btn btn-success btn-lg w-100 mt-3" data-ci-require="selfie">
                        <i class="ti ti-device-floppy"></i> {{ __('Salvar devolução', 'checklistitens') }}
                    </button>
                </div>
            </div>
        </form>
    {% endif %}

    <div class="d-flex gap-2 mt-2">
        <a href="{{ home_url }}" class="btn btn-outline-secondary flex-fill"><i class="ti ti-arrow-left"></i> {{ __('Voltar', 'checklistitens') }}</a>
        <a href="{{ logout_url }}" class="btn btn-outline-danger flex-fill"><i class="ti ti-power"></i> {{ __('Sair', 'checklistitens') }}</a>
    </div>
</div>
