{# Cartão de um uso, do começo ao fim (registro do equipamento e página de um uso) #}

{# Resultado do checklist numa fase; aqui também o "ok" e os laudos exibidos sem ser o problema #}
{% macro result(phase) %}
    {% import '@checklistitens/parts/record.html.twig' as record %}
    {% if not phase.problems|length %}
        <span class="badge bg-green-lt">{{ __('Equipamento ok', 'checklistitens') }}</span>
    {% endif %}
    {{ record.problems(phase) }}
    {% if phase.laudos|length and not phase.known %}
        <div class="ci-small text-muted mt-1">
            <i class="ti ti-file-alert"></i> {{ __('Laudos em aberto exibidos', 'checklistitens') }}:
            {% for l in phase.laudos %}
                {% if l.url %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.name }}</a>{% else %}{{ l.name }}{% endif %} ({{ l.status }}){{ not loop.last ? ', ' }}
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{# e: um item de UsageTimeline::entry; link: o número do uso leva à página do uso #}
{% macro card(e, link) %}
    {% import _self as usage %}
    {% import '@checklistitens/parts/record.html.twig' as record %}
    {% import '@checklistitens/parts/location.html.twig' as location %}
    {% import '@checklistitens/parts/usage_note.html.twig' as note %}
    <div class="card mb-3" id="usage-{{ e.id }}">
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <div>
                {% if link %}<a href="{{ e.url }}" class="ci-small me-1" title="{{ __('Ver o uso', 'checklistitens') }}">#{{ e.id }}</a>{% endif %}
                <strong>{{ e.user }}</strong> <span class="text-muted ci-small">{{ e.sector }}</span>
            </div>
            <span class="badge bg-{{ e.status_color }}">{{ e.status_label }}</span>
        </div>
        <div class="list-group list-group-flush">
            <div class="list-group-item d-flex gap-3 align-items-center">
                {{ record.selfie(e.checkout.selfie) }}
                <div class="flex-fill">
                    {% if e.delivery %}
                        {# Uso que faz parte de uma entrega para embarcação, feita pelo gestor #}
                        <div class="fw-bold">
                            <i class="ti ti-ship"></i>
                            {% if e.status == 4 %}
                                {{ __('Saiu da entrega por problema', 'checklistitens') }}
                            {% elseif e.status == 5 %}
                                {{ __('Em separação para a embarcação', 'checklistitens') }}
                            {% else %}
                                {{ __('Entrega para a embarcação', 'checklistitens') }}
                            {% endif %}
                            {{ e.delivery.vessel }}
                        </div>
                        <div class="ci-small">
                            {{ e.checkout.when }} · {{ __('turno', 'checklistitens') }} {{ e.checkout.shift }}
                            · <a href="{{ e.delivery.url }}">{{ __('Ver a entrega', 'checklistitens') }}</a>
                        </div>
                    {% else %}
                        <div class="fw-bold"><i class="ti ti-login"></i> {{ e.status == 4 ? __('Tentativa de retirada', 'checklistitens') : __('Retirada', 'checklistitens') }}</div>
                        <div class="ci-small">{{ e.checkout.when }} · {{ __('turno', 'checklistitens') }} {{ e.checkout.shift }}</div>
                    {% endif %}
                    {{ usage.result(e.checkout) }}
                    <div class="mt-1">{{ location.map(e.checkout.location) }}</div>
                </div>
            </div>

            {% if e.confirmation %}
                <div class="list-group-item d-flex gap-3 align-items-center">
                    {{ record.selfie(e.confirmation.selfie) }}
                    <div>
                        <div class="fw-bold"><i class="ti ti-user-check"></i> {{ __('Conferência do gestor', 'checklistitens') }}</div>
                        <div class="ci-small">{{ e.confirmation.user }} · {{ e.confirmation.when }}</div>
                        <div class="mt-1">{{ location.map(e.confirmation.location) }}</div>
                    </div>
                </div>
            {% endif %}

            {% if e.checkin %}
                <div class="list-group-item d-flex gap-3 align-items-center">
                    {{ record.selfie(e.checkin.selfie) }}
                    <div class="flex-fill">
                        <div class="fw-bold"><i class="ti ti-logout"></i> {{ e.delivery ? __('Recebimento da embarcação', 'checklistitens') : __('Devolução', 'checklistitens') }}</div>
                        <div class="ci-small">{{ e.checkin.when }} · {{ __('turno', 'checklistitens') }} {{ e.checkin.shift }}{% if e.duration %} · {{ __('duração', 'checklistitens') }} {{ e.duration }}{% endif %}</div>
                        {{ usage.result(e.checkin) }}
                        <div class="mt-1">{{ location.map(e.checkin.location) }}</div>
                    </div>
                </div>
            {% endif %}

            {% if e.checkin_confirmation %}
                <div class="list-group-item d-flex gap-3 align-items-center">
                    {{ record.selfie(e.checkin_confirmation.selfie) }}
                    <div>
                        <div class="fw-bold"><i class="ti ti-user-check"></i> {{ __('Devolução conferida', 'checklistitens') }}</div>
                        <div class="ci-small">{{ e.checkin_confirmation.user }} · {{ e.checkin_confirmation.when }}</div>
                        <div class="mt-1">{{ location.map(e.checkin_confirmation.location) }}</div>
                    </div>
                </div>
            {% endif %}

            {% if e.not_returned %}
                <div class="list-group-item">
                    <div class="fw-bold text-danger"><i class="ti ti-alert-triangle"></i> {{ __('Devolução não registrada', 'checklistitens') }}</div>
                    <div class="ci-small">{{ __('Encerrado por %1$s em %2$s', 'checklistitens')|format(e.not_returned.user, e.not_returned.when) }}</div>
                    {% if e.not_returned.note %}
                        <div class="ci-small mt-1"><strong>{{ __('Observação', 'checklistitens') }}:</strong> {{ e.not_returned.note|nl2br }}</div>
                    {% endif %}
                    {{ note.history(e.not_returned.history, 2) }}
                </div>
            {% endif %}

            {% if e.block %}
                <div class="list-group-item">
                    <div class="fw-bold"><i class="ti ti-lock"></i> {{ __('Bloqueio', 'checklistitens') }}: {{ e.block.status_label }}</div>
                    <div class="ci-small">
                        {% if e.block.ticket_id %}
                            <a href="{{ e.block.ticket_url }}" target="_blank" rel="noopener">{{ __('Chamado', 'checklistitens') }} #{{ e.block.ticket_id }}</a> ({{ e.block.ticket_status }})
                        {% else %}
                            {{ __('Sem chamado ainda', 'checklistitens') }}
                        {% endif %}
                        {% if e.block.release_label %} · {{ e.block.release_label }}{% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endmacro %}
