{# Página de um uso: o equipamento no topo e o uso, do começo ao fim #}
{% import '@checklistitens/parts/usage_card.html.twig' as card %}

<div class="ci-page ci-page-wide container-fluid">
    <h2 class="ci-title mb-3"><i class="{{ usage_icon }}"></i> {{ __('Uso #%d', 'checklistitens')|format(usage.id) }}</h2>

    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap justify-content-between gap-3">
            <div>
                <div class="text-muted ci-small"><i class="{{ icon }}"></i> {{ type_label }}</div>
                <div class="fs-3 fw-bold">{{ label }}</div>
                <div class="text-muted">{{ detail }}</div>
                <div class="ci-small mt-1">
                    {{ __('Colaborador', 'checklistitens') }}: {{ usage.user }}
                    · {{ __('Setor', 'checklistitens') }}: {{ usage.sector ?: '—' }}
                </div>
                <div class="ci-small">
                    {{ __('Retirada', 'checklistitens') }}: {{ usage.checkout.when }}
                    {% if usage.duration %} · {{ __('Duração', 'checklistitens') }}: {{ usage.duration }}{% endif %}
                </div>
            </div>
            <div class="text-end">
                <span class="badge bg-{{ usage.status_color }} fs-5">{{ usage.status_label }}</span>
                <div class="mt-2">
                    <a href="{{ record_url }}" class="btn btn-sm btn-outline-primary">
                        <i class="ti ti-history"></i> {{ __('Registro completo do equipamento', 'checklistitens') }}
                    </a>
                </div>
            </div>
        </div>
    </div>

    {{ card.card(usage, false) }}

    <a href="{{ list_url }}" class="btn btn-outline-secondary"><i class="ti ti-arrow-left"></i> {{ __('Usos de equipamentos', 'checklistitens') }}</a>
</div>
