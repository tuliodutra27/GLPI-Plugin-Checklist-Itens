{# Administradores: limpeza manual das selfies e das localizações depois dos prazos de guarda #}
<div class="ci-page container-fluid">
    <h2 class="ci-title mb-3"><i class="ti ti-trash"></i> {{ __('Limpeza de selfies e localizações', 'checklistitens') }}</h2>

    <div class="alert alert-info">
        {{ __('Nada é apagado automaticamente. Depois dos prazos de guarda, você pode limpar as selfies e as localizações antigas. Os registros de uso (quem, quando, problemas, chamados) são mantidos.', 'checklistitens') }}
    </div>

    {# ---------------------------------------------------------------- SELFIES #}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-camera"></i> {{ __('Selfies', 'checklistitens') }}</h3>
        </div>
        <form method="get" action="{{ page_url }}">
            <input type="hidden" name="location_limit" value="{{ location_limit }}">
            <div class="card-body row g-2 align-items-end">
                <div class="col-12">
                    <div class="text-muted ci-small">{{ __('Guardadas por pelo menos %d dias.', 'checklistitens')|format(retention_days) }}</div>
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label">{{ __('Limpar selfies gravadas até', 'checklistitens') }}</label>
                    <input type="date" name="date_limit" value="{{ limit }}" max="{{ max_limit }}" class="form-control">
                </div>
                <div class="col-12 col-md-3">
                    <button type="submit" class="btn btn-outline-primary w-100"><i class="ti ti-calculator"></i> {{ __('Calcular', 'checklistitens') }}</button>
                </div>
            </div>
        </form>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div><strong>{{ count }}</strong> {{ __('selfie(s) até essa data', 'checklistitens') }} · {{ size }}</div>
            {% if can_purge and count > 0 %}
                <form method="post" action="{{ page_url }}" onsubmit="return confirm('{{ __('Apagar definitivamente as selfies até a data escolhida? Esta ação não pode ser desfeita.', 'checklistitens')|e('js') }}');">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="date_limit" value="{{ limit }}">
                    <button type="submit" name="purge" value="1" class="btn btn-danger">
                        <i class="ti ti-trash"></i> {{ __('Apagar %d selfie(s)', 'checklistitens')|format(count) }}
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    {# ---------------------------------------------------------------- LOCALIZAÇÕES #}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-map-pin"></i> {{ __('Localizações', 'checklistitens') }}</h3>
        </div>
        <form method="get" action="{{ page_url }}">
            <input type="hidden" name="date_limit" value="{{ limit }}">
            <div class="card-body row g-2 align-items-end">
                <div class="col-12">
                    <div class="text-muted ci-small">{{ __('Guardadas por %d dias (ajustável na Configuração).', 'checklistitens')|format(location_retention_days) }}</div>
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label">{{ __('Limpar localizações registradas até', 'checklistitens') }}</label>
                    <input type="date" name="location_limit" value="{{ location_limit }}" max="{{ location_max_limit }}" class="form-control">
                </div>
                <div class="col-12 col-md-3">
                    <button type="submit" class="btn btn-outline-primary w-100"><i class="ti ti-calculator"></i> {{ __('Calcular', 'checklistitens') }}</button>
                </div>
            </div>
        </form>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div><strong>{{ location_count }}</strong> {{ __('localização(ões) até essa data', 'checklistitens') }}</div>
            {% if can_purge and location_count > 0 %}
                <form method="post" action="{{ page_url }}" onsubmit="return confirm('{{ __('Apagar definitivamente as localizações até a data escolhida? Esta ação não pode ser desfeita.', 'checklistitens')|e('js') }}');">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="location_limit" value="{{ location_limit }}">
                    <button type="submit" name="purge_locations" value="1" class="btn btn-danger">
                        <i class="ti ti-trash"></i> {{ __('Apagar %d localização(ões)', 'checklistitens')|format(location_count) }}
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    {# ---------------------------------------------------------------- HISTÓRICO #}
    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">{{ __('Limpezas anteriores', 'checklistitens') }}</h3></div>
        <div class="table-responsive">
            <table class="table card-table">
                <thead>
                    <tr>
                        <th>{{ __('Quando', 'checklistitens') }}</th>
                        <th>{{ __('O quê', 'checklistitens') }}</th>
                        <th>{{ __('Por', 'checklistitens') }}</th>
                        <th>{{ __('Até', 'checklistitens') }}</th>
                        <th>{{ __('Quantidade', 'checklistitens') }}</th>
                        <th>{{ __('Espaço liberado', 'checklistitens') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for h in history %}
                        <tr><td>{{ h.when }}</td><td>{{ h.type }}</td><td>{{ h.user }}</td><td>{{ h.limit }}</td><td>{{ h.files }}</td><td>{{ h.size }}</td></tr>
                    {% else %}
                        <tr><td colspan="6" class="text-muted">{{ __('Nenhuma limpeza feita ainda.', 'checklistitens') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <a href="{{ home_url }}" class="btn btn-outline-secondary"><i class="ti ti-arrow-left"></i> {{ __('Voltar', 'checklistitens') }}</a>
</div>
